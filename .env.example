# Primary quote source. Free tier at finnhub.io.
# Everything works without it: Yahoo Finance and Stooq need no credentials.
FINNHUB_KEY=

# Optional enrichment sources.
FMP_KEY=
AV_KEY=
TWELVE_DATA_KEY=

# Server-side key for the AI analysis panel. Visitors can supply their own
# in the UI instead, in which case this stays empty.
OPENAI_KEY=

# Infrastructure. The defaults match docker-compose.
REDIS_URL=redis://localhost:6379/0
POSTGRES_DSN=postgresql+asyncpg://markr:markr@localhost:5432/markr

# Browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Cache TTLs in seconds, one per resource.
TTL_QUOTE=30
TTL_LIST_QUOTE=30
TTL_CANDLE=300
TTL_NEWS=900
TTL_SEARCH=3600
TTL_FUNDAMENTALS=3600
TTL_STOCK_METRICS=3600
TTL_ANALYST=3600
TTL_ENRICH=21600
TTL_PROFILE=86400
TTL_DEFAULT=600

# Token bucket per source: "capacity,refill_rate_per_second".
RATE_FINNHUB=30,0.5
RATE_YAHOO=60,2.0
RATE_ALPHAVANTAGE=5,0.083
RATE_FMP=10,0.167
RATE_STOOQ=30,1.0
RATE_TWELVEDATA=8,0.133
RATE_OPENAI=20,0.2

# Result limits and how many months of partitions to keep ahead.
HISTORY_DEFAULT_LIMIT=1000
HISTORY_MAX_LIMIT=10000
PARTITION_MONTHS_AHEAD=3
