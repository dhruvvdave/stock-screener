# Required
FINNHUB_KEY=your_finnhub_key_here

# Optional — enrichment sources
FMP_KEY=
AV_KEY=
TWELVE_DATA_KEY=

# Infrastructure (defaults work with docker-compose)
REDIS_URL=redis://localhost:6379/0
POSTGRES_DSN=postgresql+asyncpg://markr:markr@localhost:5432/markr

# Cache TTLs (seconds)
TTL_5MIN=60
TTL_1H=300
TTL_1D=3600

# Partition maintenance — rolling window of monthly price_history partitions.
# Back covers the longest candle range the app can request (2y), so a full
# backfill has somewhere to land. Forward is the drift buffer; the scheduler
# re-runs every PARTITION_REFRESH_HOURS, long before the window is exhausted.
PARTITION_MONTHS_BACK=24
PARTITION_MONTHS_FORWARD=3
PARTITION_REFRESH_HOURS=24

# Rate limit buckets: "capacity,refill_rate_per_second"
RATE_FINNHUB=30,0.5
RATE_YAHOO=60,2.0
RATE_ALPHAVANTAGE=5,0.083
RATE_FMP=10,0.167
RATE_STOOQ=30,1.0
RATE_TWELVEDATA=8,0.133
